# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets
.env

# Node / Astro
node_modules/
site/dist/
site/.astro/

# Media files must NEVER be committed (large; git keeps history forever).
# The pipeline downloads media to a temp dir, transcribes, then deletes it
# (transcribe.MEDIA_TMP_PREFIX marks the dir; ingest removes it in a finally).
*.mp3
*.mp4
*.m4a
*.wav
*.webm
*.mkv
*.opus

# OS
.DS_Store

# Playwright / screenshots
.playwright-mcp/
*.png

# Transcripts are never committed (copyright); reviewer re-ingests to verify.
data/transcripts/

# Pipeline run artifacts written to the repo root by the CLI (`--pr-body-out`,
# `--out-dir`). Committed once by accident in #71; every local backfill or
# ingest-url run rewrites them, which shows up as a spurious diff.
pr_body.md
review_comment.md
changed_files.txt
/*.md.tmp
