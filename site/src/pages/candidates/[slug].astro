---
import Base from "../../layouts/Base.astro";
import { loadTrackedCandidates, buildCandidateProfile, STANCE_META, OUTCOME_META } from "../../lib/data.js";

export function getStaticPaths() {
  return loadTrackedCandidates().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const profile = buildCandidateProfile(slug);
const base = import.meta.env.BASE_URL;
const { candidate, positions, timeline } = profile;
---
<Base title={candidate.name + " on housing"} description={candidate.bio}>
  <section class="hero">
    <h1>{candidate.name}</h1>
    <p>
      <span class={"status " + candidate.status}>{candidate.status}</span>
      {candidate.party ? " · " + candidate.party : ""}
      {candidate.website && <> · <a href={candidate.website}>Campaign / office</a></>}
    </p>
    {candidate.bio && <p>{candidate.bio}</p>}
    {candidate.status_note && <p class="status-note">{candidate.status_note}</p>}
  </section>

  <h2 style="font-family:var(--serif)">Positions</h2>
  {positions.length === 0 && (
    <p class="src">No housing positions on the record yet.</p>
  )}
  {positions.map((p) => {
    const meta = STANCE_META[p.stance.stance];
    return (
      <article class="position" id={p.topic.slug}>
        <h3>{p.topic.label}</h3>
        <span class={"pill tone-" + meta.tone}>
          <span class="lbl">{meta.label}</span>
        </span>
        <p>{p.stance.summary}</p>
        {/* Only the ABSENCE is shown. When a mechanism exists the summary is
            drawn from the same quote and restates it almost verbatim ("Will
            waive fees for new affordable housing buildings..." vs "waive fees
            for new affordable housing buildings..."), with the quote itself
            directly below — three copies of one sentence. The field still earns
            its place: it marks the matrix, and it decides which statement a cell
            cites. */}
        {"mechanism" in p.stance && p.stance.mechanism === null && (
          <p class="mechanism none">No specific mechanism stated.</p>
        )}
        {p.stance.record && p.stance.record.length > 0 && (
          <div class="record">
            {/* Not "In office": the record covers appointed roles too, and the
                first candidate to carry one (matthew-brewer, #57) chaired the CHA
                by appointment and has never held elected office. A heading that
                implies election would misstate that on the profile itself. */}
            <h4>Record</h4>
            <ul>
              {p.stance.record.map((r) => {
                const om = OUTCOME_META[r.outcome] || { label: r.outcome, tone: "none" };
                return (
                  <li>
                    <span class={"pill tone-" + om.tone}><span class="lbl">{om.label}</span></span>
                    <span class="action">{r.action}</span>
                    {r.date && <span class="src"> · {r.date}</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        )}
        {p.sources.map(({ statement, evidence }) => (
          <div>
            <blockquote class="quote">“{statement.quote}”</blockquote>
            <p class="src">
              — <a href={evidence.url}>{evidence.outlet}</a>, {evidence.published_date}
              {statement.locator ? " (" + statement.locator + ")" : ""}
            </p>
          </div>
        ))}
      </article>
    );
  })}

  <h2 style="font-family:var(--serif)">Media timeline</h2>
  {timeline.map((e) => (
    <div class="hit">
      <div class="meta">{e.published_date} · {e.outlet} · {e.media_type}</div>
      <h3><a href={e.url}>{e.title}</a></h3>
    </div>
  ))}
</Base>
